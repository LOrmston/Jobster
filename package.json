{
  "name": "jobster",
  "private": true,
  "version": "0.1.0",
  "description": "Hinge-style matching for job seekers and employers.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev -w @jobster/api\" \"npm run dev -w @jobster/web\"",
    "build": "npm run build -w @jobster/web",
    "start": "npm run start -w @jobster/api",
    "seed": "npm run seed -w @jobster/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy": "wrangler deploy",
    "cf:dev": "wrangler dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "~5.7.3",
    "vite": "^6.4.0",
    "vitest": "^5.0.5",
    "wrangler": "~4.145.0"
  }
}
